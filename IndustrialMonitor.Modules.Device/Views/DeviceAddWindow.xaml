<UserControl x:Class="IndustrialMonitor.Modules.Device.Views.DeviceAddWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IndustrialMonitor.Modules.Device.Views"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="250">
    <Grid>
        <StackPanel>
            <WrapPanel Margin="5">
                <TextBlock Text="IpAddress" Width="100"></TextBlock>
                <TextBox Width="100" 
                         Text="{Binding DeviceConfig.IpAddress,
                         UpdateSourceTrigger=PropertyChanged}"></TextBox>
            </WrapPanel>
            
            <WrapPanel Margin="5">
                <TextBlock Text="Port" Width="100"></TextBlock>
                <TextBox Width="100" 
                         Text="{Binding DeviceConfig.Port,
                         UpdateSourceTrigger=PropertyChanged}"></TextBox>
            </WrapPanel>
            
            <WrapPanel Margin="5">
                <TextBlock Text="SlaveId" Width="100"></TextBlock>
                <TextBox Width="100" 
                         Text="{Binding DeviceConfig.SlaveId,
                         UpdateSourceTrigger=PropertyChanged}"></TextBox>
            </WrapPanel>
            
            <WrapPanel Margin="5">
                <TextBlock Text="StartAddress" Width="100"></TextBlock>
                <TextBox Width="100" 
                         Text="{Binding DeviceConfig.StartAddress,
                         UpdateSourceTrigger=PropertyChanged}"></TextBox>
            </WrapPanel>
            
            <WrapPanel Margin="5">
                <TextBlock Text="NumberOfPoints" Width="100"></TextBlock>
                <TextBox Width="100" 
                         Text="{Binding DeviceConfig.NumberOfPoints,
                         UpdateSourceTrigger=PropertyChanged}"></TextBox>
            </WrapPanel>

            <Button Content="{Binding ButtonConCent}" Command="{Binding ControlDeviceCmd}" 
                    CommandParameter="{Binding ButtonConCent}"
                    Width="100" HorizontalAlignment="Center" Margin="10"></Button>
        </StackPanel>
    </Grid>
</UserControl>
