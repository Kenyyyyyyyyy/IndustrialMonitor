<UserControl x:Class="IndustrialMonitor.Modules.Device.Views.DeviceAddWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IndustrialMonitor.Modules.Device.Views"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="250">
    <Grid>
        <StackPanel>
            <WrapPanel Margin="5">
                <TextBlock Text="IpAddress" Width="100"></TextBlock>
                <TextBox Width="100" 
                         Text="{Binding Device.IpAddress,
                         UpdateSourceTrigger=PropertyChanged}"></TextBox>
            </WrapPanel>
            <WrapPanel Margin="5">
                <TextBlock Text="Port" Width="100"></TextBlock>
                <TextBox Width="100" 
                         Text="{Binding Device.Port,
                         UpdateSourceTrigger=PropertyChanged}"></TextBox>
            </WrapPanel>
            <WrapPanel Margin="5">
                <TextBlock Text="SlaveId" Width="100"></TextBlock>
                <TextBox Width="100" 
                         Text="{Binding Device.SlaveId,
                         UpdateSourceTrigger=PropertyChanged}"></TextBox>
            </WrapPanel>
            <WrapPanel Margin="5">
                <TextBlock Text="StartAddress" Width="100"></TextBlock>
                <TextBox Width="100" 
                         Text="{Binding Device.StartAddress,
                         UpdateSourceTrigger=PropertyChanged}"></TextBox>
            </WrapPanel>
            <WrapPanel Margin="5">
                <TextBlock Text="NumberOfPoints" Width="100"></TextBlock>
                <TextBox Width="100" 
                         Text="{Binding Device.NumberOfPoints,
                         UpdateSourceTrigger=PropertyChanged}"></TextBox>
            </WrapPanel>

            <Button Content="添加" Command="{Binding AddDeviceCmd}" Width="100" HorizontalAlignment="Center" Margin="10"></Button>
        </StackPanel>
    </Grid>
</UserControl>
