<UserControl x:Class="IndustrialMonitor.Modules.Device.DeviceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IndustrialMonitor.Modules.Device"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">

            <WrapPanel>
                <Button Content="添加设备" Command="{Binding OpenAddCmd}"
                        Width="60" Height="20" HorizontalAlignment="Left" Margin="10">
                </Button>

                <Button Content="刷新连接" Command="{Binding LoadDeviceCmd}"
                        Width="60" Height="20" HorizontalAlignment="Left" Margin="10">
                </Button>

                <Button Content="连接PLC" Command="{Binding PLCConnectCmd}"
                        Width="60" Height="20" HorizontalAlignment="Left" Margin="10">

                </Button>
            </WrapPanel>
        </Grid>


        <ItemsControl Grid.Row="1" ItemsSource="{Binding Devices}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="4" Rows="2">

                    </UniformGrid>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <WrapPanel>
                            <TextBlock Text="DeviceID: "/>
                            <TextBlock Text="{Binding ConfigModel.DeviceId}" />
                        </WrapPanel>
                        
                        <WrapPanel>
                            <TextBlock Text="Device: "/>
                            <TextBlock Text="{Binding ConfigModel.DeviceName}"/>
                        </WrapPanel>
                        
                        <WrapPanel>
                            <TextBlock Text="DeviceType: "/>
                            <TextBlock Text="{Binding ConfigModel.DeviceType}"/>
                        </WrapPanel>
                        
                        <WrapPanel>
                            <TextBlock Text="状态: "/>
                            <TextBlock Text="{Binding ConnectionResult.IsRunning}"/>
                        </WrapPanel>

                        <TextBlock Text="{Binding ConnectionResult.ErrorMessage}"/>


                        <Button Content="连接设备" 
                                Command="{Binding ConnectCommand}"/>
                        
                        <Button Content="断开设备" 
                                Command="{Binding DisconnectCommand}"/>
                        
                        <Button Content="修改设备" 
                                Command="{Binding DataContext.UpdataCommand,
                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"/>
                                
                        <Button Content="删除设备" 
                                Command="{Binding DataContext.DeleteCommand,
                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"/>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
            
        </ItemsControl>
    </Grid>
</UserControl>
