<UserControl x:Class="IndustrialMonitor.Modules.Dashboard.Views.LCGraphDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IndustrialMonitor.Modules.Dashboard.Views"
             xmlns:lvc ="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:prism="http://prismlibrary.com/"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="800">

    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="Width" Value="1000"/>
            <Setter Property="Height" Value="650"/>
            <Setter Property="MinWidth" Value="800"/>
            <Setter Property="MinHeight" Value="500"/>
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen"/>
            <Setter Property="ResizeMode" Value="CanResize"/>
        </Style>
    </prism:Dialog.WindowStyle>
    
    

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <StackPanel>
            <WrapPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Button Content="温度" Width="60" Height="20" Margin="20" Command="{Binding ChangeItemCommand}" CommandParameter="temputer" />
                <Button Content="压力" Width="60" Height="20"             Command="{Binding ChangeItemCommand}" CommandParameter="stress" />
                <Button Content="产量" Width="60" Height="20" Margin="20" Command="{Binding ChangeItemCommand}" CommandParameter="yield" />
                <Button Content="运行状态" Width="60" Height="20"          Command="{Binding ChangeItemCommand}" CommandParameter="status" />
            </WrapPanel>
            <WrapPanel VerticalAlignment="Center" HorizontalAlignment="Center" >
                <RadioButton GroupName="interval" Margin="10,0,10,0" IsChecked="True" 
                             Command="{Binding ChangeIntervalCommand}" CommandParameter="min">   分 </RadioButton>
                <RadioButton GroupName="interval" Margin="10,0,10,0" 
                             Command="{Binding ChangeIntervalCommand}" CommandParameter="hour">  时 </RadioButton>
                <RadioButton GroupName="interval" Margin="10,0,10,0" 
                             Command="{Binding ChangeIntervalCommand}" CommandParameter="day">   天 </RadioButton>
                <RadioButton GroupName="interval" Margin="10,0,10,0"
                             Command="{Binding ChangeIntervalCommand}" CommandParameter="week">  周 </RadioButton>
                <RadioButton GroupName="interval" Margin="10,0,10,0" 
                             Command="{Binding ChangeIntervalCommand}" CommandParameter="month"> 月 </RadioButton>
            </WrapPanel>
        </StackPanel>
       
        

        <lvc:CartesianChart Grid.Row="1" 
                    Series="{Binding Series}"
                    XAxes="{Binding XAxes}"
                    YAxes="{Binding YAxes}"
                    LegendPosition="Left"
                    LegendTextSize="10">
            
        </lvc:CartesianChart>
        
    </Grid>
</UserControl>
