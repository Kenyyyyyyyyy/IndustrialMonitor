<UserControl x:Class="IndustrialMonitor.Modules.Dashboard.Views.LCGraphUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IndustrialMonitor.Modules.Dashboard.Views"
             xmlns:lvc ="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="False"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="400">
    
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <WrapPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Button Content="温度" Width="60" Height="20" Margin="20" Command="{Binding ChangeValuesCommand}" CommandParameter="temputer" />
            <Button Content="压力" Width="60" Height="20"             Command="{Binding ChangeValuesCommand}" CommandParameter="stress" />
            <Button Content="产量" Width="60" Height="20" Margin="20" Command="{Binding ChangeValuesCommand}" CommandParameter="yield" />
            <Button Content="运行状态" Width="60" Height="20"          Command="{Binding ChangeValuesCommand}" CommandParameter="status" />
        </WrapPanel>

        <lvc:CartesianChart Grid.Row="1" 
                    Series="{Binding Series,Mode=TwoWay}"
                    XAxes="{Binding XAxes}"
                    YAxes="{Binding YAxes}"
                    LegendPosition="Left"
                    LegendTextSize="16">
            
        </lvc:CartesianChart>
        
    </Grid>
</UserControl>
